{
  "id": "spatial",
  "name": "spatial",
  "kind": "extension",
  "version": "0.1.0",
  "description": "PostGIS map extension bootstrap. Service handlers must be connected before use.",
  "service_protocol": 1,
  "capabilities": {
    "schemas": false,
    "views": false,
    "routines": false,
    "file_based": false,
    "identifier_quote": "\"",
    "alter_primary_key": false,
    "manage_tables": false,
    "explain": false,
    "spatial_v1": false
  },
  "min_runtime_version": "0.26.0",
  "ui_extensions": [
    {
      "slot": "data-grid.toolbar.actions",
      "module": "ui/dist/index.js",
      "driver": "postgresql"
    }
  ]
}
